# Server-only settings. Copy to a private env file or export before launch.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/saaf
TYPESAFE_API_KEY=
# JEV_API_KEY is an alternative to TYPESAFE_API_KEY.

# Required by `next start` / every production deployment. Missing/short password = 503.
# Generate a unique >=24-character password OUTSIDE source control. Use HTTPS.
SAAF_OPERATOR_USER=operator
SAAF_OPERATOR_PASSWORD=
# This is a single trusted-operator demo, NOT a tenant-isolated multi-user product.

# Explicit operator-only fixture initialization. Disabled unless exactly true.
SAAF_ENABLE_SEED=false
# Enforce separately verified reviewer signatures at /api/verify.
# Public keys only; NEVER put private signing/KMS credentials in this app.
SAAF_REQUIRE_ATTESTATION=false
SAAF_REVIEW_PUBLIC_KEYS_JSON={}
# Python CLI: use a stable persistent database for cumulative authorization budgets.
# SAAF_BUDGET_DB=/private/saaf/order-budgets.sqlite
